---
/** Design reminder — Policy pages are clear, local-language documents with the same archival identity. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
interface Props { locale: 'es' | 'en'; kind: 'privacy' | 'terms' | 'cookies'; }
const { locale, kind } = Astro.props; const en = locale === 'en';
type PolicyContent = [string, string, Array<[string, string]>];
const copy: Record<'privacy' | 'terms' | 'cookies', PolicyContent> = en ? {
  privacy: ['Privacy policy', 'This independent guide uses the minimum information required to operate the website. The policy is written for this website as it is: it has no accounts, database, booking system or contact form.', [['Information used', 'Basic server requests may process technical information such as IP address, browser type and visited pages. If you opt in, Google Analytics may process aggregated usage data.'], ['How it is used', 'Information is used only to maintain the guide, understand aggregate use, improve accessibility and meet applicable obligations.'], ['Third-party services', 'The map may connect to Google when its embedded content loads. Fonts are requested from Google Fonts. These resources are independent of the analytics setting. Google Analytics loads after an optional grant; withdrawing applies runtime denial but does not erase earlier processing. The server requests model weather from Open-Meteo using the square’s coordinates, not your location. Each provider has its own policy.'], ['Your choices', 'You can change analytics consent at any time on the Cookie settings page. Privacy rights depend on your jurisdiction; you may contact the relevant provider or authority for requests concerning its processing.']]],
  terms: ['Terms of use', 'By using this guide, you accept these terms. It is an independent visitor guide and does not represent the municipal sources it cites.', [['Informational purpose', 'Content is for general visitor orientation, not a guarantee of access, safety, prices, transport operations or service availability.'], ['Accuracy and changes', 'The guide aims to use public sources and distinguishes interpretation from operational information. Conditions can change without notice; verify important plans with official or local channels.'], ['Images and original work', 'Photographs remain the property of their authors or rightsholders. Original writing and design are protected as applicable. Google Maps use remains subject to Google terms.'], ['Liability', 'The guide is offered as-is. Travel decisions remain the visitor’s responsibility, including weather, mobility, access and personal safety.']]],
  cookies: ['Cookie settings', 'This page controls optional analytics for this guide. Essential technical storage may be used to remember your preference; the control applies to this Google Analytics integration.', [['Essential preference', 'Local storage records the analytics choice. Session storage may keep a refusal for this tab when shared persistence fails. The result explains whether the choice was saved.'], ['Analytics', 'Optional. If enabled, Google Analytics is loaded to understand aggregated traffic and usage patterns.'], ['Marketing', 'This control does not enable advertising consent.']]],
} : {
  privacy: ['Política de privacidad', 'Esta guía independiente usa la información mínima necesaria para operar el sitio. El texto describe el sitio tal como existe: no tiene cuentas, base de datos, reservas ni formulario de contacto.', [['Información utilizada', 'Las solicitudes al servidor pueden procesar datos técnicos básicos como dirección IP, tipo de navegador y páginas visitadas. Si aceptás, Google Analytics puede procesar datos de uso agregados.'], ['Uso de la información', 'Se utiliza solo para mantener la guía, entender el uso agregado, mejorar accesibilidad y cumplir obligaciones aplicables.'], ['Servicios de terceros', 'El mapa puede conectar con Google al cargar su contenido. Las fuentes se solicitan a Google Fonts. Esos recursos son independientes de la opción analítica. Google Analytics se carga tras aceptar; al retirar el permiso aplicamos la negativa a la medición ya cargada, sin borrar datos tratados antes. El servidor pide el pronóstico a Open-Meteo con las coordenadas de la plaza, no tu ubicación. Cada proveedor aplica su política.'], ['Tus opciones', 'Podés modificar el consentimiento analítico en cualquier momento desde Configuración de cookies. Los derechos de privacidad dependen de tu jurisdicción; podés contactar al proveedor o autoridad correspondiente por solicitudes sobre su tratamiento.']]],
  terms: ['Términos de uso', 'Al usar esta guía aceptás estos términos. Es una guía independiente para visitantes y no representa a las fuentes municipales citadas.', [['Finalidad informativa', 'El contenido es una orientación general para visitantes, no una garantía de acceso, seguridad, tarifas, operación de transporte ni disponibilidad de servicios.'], ['Exactitud y cambios', 'La guía prioriza fuentes públicas y diferencia interpretación de información operativa. Las condiciones pueden cambiar sin aviso; verificá los planes importantes con canales oficiales o locales.'], ['Imágenes y obra original', 'Las fotografías pertenecen a sus autores o titulares de derechos. La redacción y diseño originales están protegidos según corresponda. El uso de Google Maps se rige por los términos de Google.'], ['Responsabilidad', 'La guía se ofrece tal como está. Las decisiones de viaje son responsabilidad del visitante, incluidos clima, movilidad, acceso y seguridad personal.']]],
  cookies: ['Configuración de cookies', 'Esta página controla la analítica opcional de esta guía. Puede usarse almacenamiento técnico esencial para recordar tu elección; el control se aplica a esta integración de Google Analytics.', [['Preferencia esencial', 'El almacenamiento local registra la elección analítica. El almacenamiento de sesión puede conservar una negativa en esta pestaña cuando falla el guardado compartido. El resultado indica si se pudo guardar la decisión.'], ['Analítica', 'Opcional. Si la activás, se carga Google Analytics para comprender tráfico agregado y patrones de uso.'], ['Marketing', 'Este control no habilita consentimiento publicitario.']]],
};
const [title, intro, sections] = copy[kind]; const base = en ? '/en' : '';
---
<BaseLayout title={`${title} | Plaza Colón Córdoba`} description={intro} locale={locale}>
  <div id="top"></div><SiteHeader locale={locale} />
  <main id="content" class="policy-main"><article class="policy-article"><p class="eyebrow">{en ? 'Plaza Colón · public-interest guide' : 'Plaza Colón · guía de interés público'}</p><h1>{title}</h1><p class="policy-intro">{intro}</p><p class="policy-version">{en ? 'Updated: 22 October 2026' : 'Actualización: 22 de octubre de 2026'}</p>{sections.map(([heading, text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}{kind === 'cookies' && <div class="consent-panel" data-consent-panel><p>{en ? 'Choose the analytics preference for this browser.' : 'Elegí la preferencia de analítica para este navegador.'}</p><div><button data-consent="granted" class="button button-bronze">{en ? 'Allow analytics' : 'Permitir analítica'}</button><button data-consent="denied" class="button button-outline">{en ? 'Essential only' : 'Solo esenciales'}</button></div><p role="status" aria-live="polite" data-consent-status></p></div>}<a class="inline-link" href={`${base}/`}>{en ? 'Back to the guide' : 'Volver a la guía'} ↑</a></article></main>
  <SiteFooter locale={locale} />
  {kind === 'cookies' && <script is:inline>
    (() => {
      const panel = document.querySelector('[data-consent-panel]');
      if (!panel || !window.plazaConsent) return;
      const en = document.documentElement.lang.startsWith('en');
      const status = panel.querySelector('[data-consent-status]');
      const fill = () => {
        const granted = window.plazaConsent.read();
        panel.querySelectorAll('[data-consent]').forEach((button) => button.setAttribute('aria-pressed', String((button.dataset.consent === 'granted') === granted)));
      };
      fill();
      if (status) status.textContent = window.plazaConsent.read() ? (en ? 'Analytics is currently enabled.' : 'La analítica está activada.') : (en ? 'Analytics is currently off.' : 'La analítica está desactivada.');
      panel.querySelectorAll('[data-consent]').forEach((button) => button.addEventListener('click', () => {
        const result = window.plazaConsent.save(button.dataset.consent === 'granted');
        fill(); if (status) status.textContent = result.message;
      }));
      window.addEventListener('plaza-consent-updated', fill);
    })();
  </script>}
</BaseLayout>
