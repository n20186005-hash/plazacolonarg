---
/** Design reminder — Policy pages are clear, local-language documents with the same archival identity. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
interface Props { locale: 'es' | 'en'; kind: 'privacy' | 'terms' | 'cookies'; }
const { locale, kind } = Astro.props; const en = locale === 'en';
type PolicyContent = [string, string, Array<[string, string]>];
const copy: Record<'privacy' | 'terms' | 'cookies', PolicyContent> = en ? {
  privacy: ['Privacy policy', 'This independent non-profit guide uses the minimum information required to operate the website. The policy is written for this website as it is: it has no accounts, database, booking system or contact form.', [['Information used', 'Basic server requests may process technical information such as IP address, browser type and visited pages. If you opt in, Google Analytics may process aggregated usage data.'], ['How it is used', 'Information is used only to maintain the guide, understand aggregate use, improve accessibility and meet applicable obligations.'], ['Third-party services', 'Google Maps is embedded to show the location. Google Analytics is loaded only after analytics consent. Each provider applies its own policy.'], ['Your choices', 'You can change analytics consent at any time on the Cookie settings page. Privacy rights depend on your jurisdiction; you may contact the relevant provider or authority for requests concerning its processing.']]],
  terms: ['Terms of use', 'By using this guide, you accept these terms. It is an independent third-party public-interest information project and is not affiliated with the attraction, a government body or any commercial operator.', [['Informational purpose', 'Content is for general visitor orientation, not a guarantee of access, safety, prices, transport operations or service availability.'], ['Accuracy and changes', 'The guide aims to use public sources and distinguishes interpretation from operational information. Conditions can change without notice; verify important plans with official or local channels.'], ['Images and original work', 'Photographs remain the property of their authors or rightsholders. Original writing and design are protected as applicable. Google Maps use remains subject to Google terms.'], ['Liability', 'The guide is offered as-is. Travel decisions remain the visitor’s responsibility, including weather, mobility, access and personal safety.']]],
  cookies: ['Cookie settings', 'This page controls optional analytics for this guide. Essential technical storage may be used to remember your preference; no advertising or personalised-marketing cookie is used by this website.', [['Essential preference', 'Always active. Local storage records whether you have selected an analytics preference.'], ['Analytics', 'Optional. If enabled, Google Analytics is loaded to understand aggregated traffic and usage patterns.'], ['Marketing', 'Not used. This guide does not serve personalised advertising or sell visitor profiles.']]],
} : {
  privacy: ['Política de privacidad', 'Esta guía independiente y sin fines de lucro usa la información mínima necesaria para operar el sitio. El texto describe el sitio tal como existe: no tiene cuentas, base de datos, reservas ni formulario de contacto.', [['Información utilizada', 'Las solicitudes al servidor pueden procesar datos técnicos básicos como dirección IP, tipo de navegador y páginas visitadas. Si aceptás, Google Analytics puede procesar datos de uso agregados.'], ['Uso de la información', 'Se utiliza solo para mantener la guía, entender el uso agregado, mejorar accesibilidad y cumplir obligaciones aplicables.'], ['Servicios de terceros', 'Google Maps se integra para mostrar la ubicación. Google Analytics se carga únicamente luego del consentimiento analítico. Cada proveedor aplica su propia política.'], ['Tus opciones', 'Podés modificar el consentimiento analítico en cualquier momento desde Configuración de cookies. Los derechos de privacidad dependen de tu jurisdicción; podés contactar al proveedor o autoridad correspondiente por solicitudes sobre su tratamiento.']]],
  terms: ['Términos de uso', 'Al usar esta guía aceptás estos términos. Es un proyecto independiente de interés público de terceros; no tiene afiliación con el atractivo, organismos de gobierno ni operadores comerciales.', [['Finalidad informativa', 'El contenido es una orientación general para visitantes, no una garantía de acceso, seguridad, tarifas, operación de transporte ni disponibilidad de servicios.'], ['Exactitud y cambios', 'La guía prioriza fuentes públicas y diferencia interpretación de información operativa. Las condiciones pueden cambiar sin aviso; verificá los planes importantes con canales oficiales o locales.'], ['Imágenes y obra original', 'Las fotografías pertenecen a sus autores o titulares de derechos. La redacción y diseño originales están protegidos según corresponda. El uso de Google Maps se rige por los términos de Google.'], ['Responsabilidad', 'La guía se ofrece tal como está. Las decisiones de viaje son responsabilidad del visitante, incluidos clima, movilidad, acceso y seguridad personal.']]],
  cookies: ['Configuración de cookies', 'Esta página controla la analítica opcional de esta guía. Puede usarse almacenamiento técnico esencial para recordar tu elección; el sitio no usa cookies de publicidad ni marketing personalizado.', [['Preferencia esencial', 'Siempre activa. El almacenamiento local registra si seleccionaste una preferencia de analítica.'], ['Analítica', 'Opcional. Si la activás, se carga Google Analytics para comprender tráfico agregado y patrones de uso.'], ['Marketing', 'No se utiliza. Esta guía no muestra publicidad personalizada ni vende perfiles de visitantes.']]],
};
const [title, intro, sections] = copy[kind]; const base = en ? '/en' : '';
---
<BaseLayout title={`${title} — Plaza Colón`} description={intro} locale={locale}>
  <div id="top"></div><SiteHeader locale={locale} />
  <main id="content" class="policy-main"><article class="policy-article"><p class="eyebrow">{en ? 'Plaza Colón · public-interest guide' : 'Plaza Colón · guía de interés público'}</p><h1>{title}</h1><p class="policy-intro">{intro}</p><p class="policy-version">{en ? 'Current wording: August 2026' : 'Redacción vigente: agosto de 2026'}</p>{sections.map(([heading, text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}{kind === 'cookies' && <div class="consent-panel"><p>{en ? 'Choose the analytics preference for this browser.' : 'Elegí la preferencia de analítica para este navegador.'}</p><div><button data-consent="granted" class="button button-bronze">{en ? 'Allow analytics' : 'Permitir analítica'}</button><button data-consent="denied" class="button button-outline">{en ? 'Essential only' : 'Solo esenciales'}</button></div></div>}<a class="inline-link" href={`${base}/`}>{en ? 'Back to the guide' : 'Volver a la guía'} ↑</a></article></main>
  <SiteFooter locale={locale} />
  {kind === 'cookies' && <script>document.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => button.addEventListener('click', () => { localStorage.setItem('plaza-colon-analytics', button.dataset.consent || 'denied'); window.dispatchEvent(new Event('plaza-consent-updated')); location.reload(); }));</script>}
</BaseLayout>
