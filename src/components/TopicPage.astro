---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { CATEGORY_LABELS, TOPIC_SOURCE, type Topic } from '../lib/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const site = Astro.site ?? new URL('https://plazacolonarg.com');
const url = new URL(Astro.url.pathname, site);
const canonical = url.href;
const categoryLabel = CATEGORY_LABELS[topic.category];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: topic.metaTitle,
  description: topic.metaDescription,
  inLanguage: 'es-AR',
  isPartOf: { '@type': 'WebSite', '@id': new URL('/#website', site).href },
  about: {
    '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings', 'Place'],
    '@id': new URL('/#attraction', site).href,
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: topic.title, item: canonical },
    ],
  },
};
---

<BaseLayout
  title={topic.metaTitle}
  description={topic.metaDescription}
  locale="es"
  faqItems={topic.faqs.map((f) => ({ question: f.question, answer: f.answer }))}
  enHreflang={false}
>
  <div id="top"></div>
  <SiteHeader locale="es" />
  <main id="content" class="visitor-guide">
    <article class="section-wrap topic-page">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span>{categoryLabel}</span>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{topic.title}</span>
      </nav>

      <p class="category-badge">{categoryLabel}</p>
      <h1>{topic.title}</h1>
      <p class="lead">{topic.lead}</p>

      {
        topic.facts && (
          <dl class="topic-facts">
            {topic.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        topic.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.paragraphs && s.paragraphs.map((p) => <p>{p}</p>)}
            {s.bullets && (
              <ul class="bullets">
                {s.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      <section id="faq">
        <h2>Preguntas frecuentes</h2>
        <div class="faq-list">
          {
            topic.faqs.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="related-topics">
        <h2>Temas relacionados</h2>
        <ul>
          {topic.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
        </ul>
      </section>

      <section class="source-note">
        <h2>Fuentes y fecha</h2>
        <p>
          Información revisada en {topic.updated}. La valoración de Google Maps es una referencia de
          terceros, no una puntuación recogida por esta guía, y puede cambiar. Fuente municipal:
          <a href={TOPIC_SOURCE}>Turismo Córdoba · Plaza Colón</a>. Esta es una guía de visita
          independiente y sin fines de lucro; no representa al municipio ni a los comercios citados.
        </p>
      </section>
    </article>
  </main>
  <SiteFooter locale="es" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</BaseLayout>
