---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import WeatherSection from './WeatherSection.astro';
interface Props { locale: 'es' | 'en'; }
const { locale } = Astro.props;
const en = locale === 'en';
const source = 'https://turismo.cordoba.gob.ar/cordoba-a-cielo-abierto-plaza-colon/';
const t = en ? {
 title: 'Plaza Colón Córdoba, Argentina: location and visitor guide', description: 'Find Plaza Colón on Av. Colón in Alberdi, Córdoba, Argentina. Map, iron fountain, history, weather and practical guidance for your visit.',
 eyebrow: 'Alberdi · Córdoba, Argentina', intro: 'Find the cast-iron fountain, trees and neighbourhood life of Plaza Colón on Av. Colón. This guide covers the square in Córdoba, Argentina.', plan: 'Plan your visit', map: 'Location and map', rename: 'Renamed', former: 'Formerly Plaza Juárez Celman',
 facts: [['Location', 'Av. Colón · Alberdi'], ['Visit', 'Outdoor public square'], ['Suggested pace', '45–75 min · editorial suggestion'], ['Google Maps', '4.1 / 5 · 18,870 reviews']],
 history: 'A square shaped by iron and trees', historyIntro: 'Municipal tourism describes the former Plaza Juárez Celman, renamed Plaza Colón in 1892. The cast-iron fountain and surrounding sculptures are central to its heritage story.',
 timeline: [['Late 19th century', 'The square began under the name Juárez Celman, during the growth of Alberdi.'], ['1892', 'It adopted the name Plaza Colón.'], ['1950s', 'Architect Carlos David remodelled the landscape and the coloured-tile fontanas.'], ['Reported restoration', 'Municipal tourism describes recovered ironwork, planting and recreation areas. Current condition and access should be checked on arrival.']],
 botTitle: 'Look beyond the fountain', botText: 'The municipal account names white ash, linden, American red oak, tipu trees and pindo palms. Notice how planting, paths and ironwork form one landscape; do not treat a historical photograph as a current condition report.',
 visitTitle: 'Prepare a flexible visit', visitText: 'These are suggestions from this guide, not operating hours or a reserved itinerary. Adapt the walk to weather, mobility and local signs.',
 visits: [['A short heritage walk', '45–75 min, as a suggestion', 'Start with the fountain and sculptures, then follow a comfortable section of the perimeter. Allow time for a pause.'], ['With children or a dog', 'Check the relevant area first', 'Municipal tourism reports a children’s area and dog enclosure. Check current condition, signs and availability; supervise children near the road and fountain.'], ['With mobility needs', 'Plan the route in advance', 'Municipal tourism reports corner ramps and tactile paths. We have not audited current surfaces, crossings or a continuous step-free route.']],
 transportTitle: 'How to reach Av. Colón', transportText: 'Use “Plaza Colón, Av. Colón, Alberdi, Córdoba, Argentina” as your destination. Confirm your route for the day rather than relying on an unverified bus number or journey time.',
 transport: [['From the airport or bus terminal', 'Check the current transfer route, luggage conditions, fare and drop-off point with your operator. This guide does not verify a specific airport service.'], ['Urban bus', 'Use the local transport service’s current journey planner with your real starting point. Check routes, stops, fares and diversions before leaving.'], ['Taxi or remís', 'Give the full destination in Córdoba, Argentina, and agree on a permitted drop-off point. Confirm the service’s fare or pricing method.'], ['Walking, cycling or driving', 'Inspect crossings and signs for your route. Confirm parking conditions independently; the guide does not provide parking or guarantee availability.']],
 servicesTitle: 'Check the practical details', services: [['Opening hours', 'No opening hours were supplied in the Google Maps listing checked on 22 October 2026. Confirm local restrictions, works or events; this guide makes no 24-hour access promise.'], ['Toilets and drinking water', 'We have no current verification of an available on-site public toilet or drinking-water point. Plan these needs before arriving.'], ['Entry and nearby interiors', 'Municipal tourism describes a public square. Check any event conditions and the separate rules of buildings or venues you add to your day.']],
 nearbyTitle: 'Continue through Alberdi', nearbyIntro: 'Municipal tourism suggests these as separate stops on a wider neighbourhood visit. Check each destination’s location, programme and access before adding it to your route.',
 nearby: [['María Auxiliadora church', 'A landmark included in the municipal Alberdi account.'], ['Isla de los Patos', 'A separate outdoor destination in the wider neighbourhood route.'], ['Plaza de la Música', 'A former industrial setting included in the municipal account; check its own programme.']],
 faqTitle: 'Questions before you go', faq: [['Where is this Plaza Colón?', 'On Av. Colón in Alberdi, city and province of Córdoba, Argentina. The Google Maps reference address is X5000EPZ Córdoba. Use the linked place record to plan the route.'], ['Is it open 24 hours?', 'We do not have verified opening hours. The Google Maps listing checked on 22 October 2026 supplied no hours. Check local restrictions or events before visiting.'], ['What should I look for?', 'The municipal account highlights the cast-iron fountain, sculptures, trees and the landscape remodelled by Carlos David in the 1950s.'], ['Are the children’s area and accessible paths available?', 'Municipal tourism reports a children’s area, dog enclosure, corner ramps and tactile paths. This is not a current inspection: check conditions on arrival.'], ['How much time should I allow?', 'This guide suggests 45–75 minutes for a relaxed look at the fountain, trees and perimeter. Adjust the time to your pace and the conditions; it is not an official tour duration.']],
 sourceTitle: 'Sources and date', sourceText: 'Public place information checked on 22 October 2026. The Google Maps rating is a third-party snapshot, not a rating collected by this guide. It may change.',
 photoText: 'Reference photograph from 2022; it may differ from today’s appearance. The image is resized and may be cropped or colour-adjusted in the page.',
} : {
 title: 'Plaza Colón Córdoba: ubicación, mapa y guía de visita', description: 'Ubicá Plaza Colón sobre Av. Colón en Alberdi, Córdoba, Argentina. Mapa, fuente de hierro, historia, clima y orientación para preparar el paseo.',
 eyebrow: 'Alberdi · Córdoba, Argentina', intro: 'Encontrá la fuente de hierro, los árboles y la vida barrial de Plaza Colón sobre Av. Colón. Esta guía trata de la plaza de Córdoba, Argentina.', plan: 'Planificar la visita', map: 'Ubicación y mapa', rename: 'Nombre actual desde', former: 'Antes Plaza Juárez Celman',
 facts: [['Ubicación', 'Av. Colón · Alberdi'], ['Visita', 'Plaza pública al aire libre'], ['Ritmo sugerido', '45–75 min · propuesta de la guía'], ['Google Maps', '4,1 / 5 · 18.870 reseñas']],
 history: 'Una plaza entre hierro y árboles', historyIntro: 'Turismo municipal describe la antigua Plaza Juárez Celman, rebautizada Plaza Colón en 1892. La fuente de hierro fundido y las esculturas de su entorno forman el núcleo de su historia patrimonial.',
 timeline: [['Fines del siglo XIX', 'La plaza comenzó con el nombre Juárez Celman durante el crecimiento de Alberdi.'], ['1892', 'Adoptó el nombre Plaza Colón.'], ['Década de 1950', 'El arquitecto Carlos David remodeló el paisaje y las fontanas de venecitas de colores.'], ['Recuperación documentada', 'Turismo municipal describe la recuperación de piezas de hierro, plantación y sectores recreativos. Comprobá su estado y acceso actuales al llegar.']],
 botTitle: 'Mirar más allá de la fuente', botText: 'La descripción municipal menciona fresnos blancos, tilos, robles rojos americanos, tipas y palmeras pindó. Observá la relación entre vegetación, senderos y metalurgia; una fotografía histórica no acredita el estado del día.',
 visitTitle: 'Preparar un paseo flexible', visitText: 'Son propuestas de esta guía, no horarios de funcionamiento ni un circuito reservado. Ajustá el paseo al tiempo, tu movilidad y la señalización local.',
 visits: [['Paseo patrimonial breve', '45–75 min como orientación', 'Empezá por la fuente y las esculturas y seguí un tramo cómodo del perímetro. Reservá tiempo para una pausa.'], ['Con niños o un perro', 'Comprobá primero el sector', 'Turismo municipal informa un patio de las infancias y un canil. Revisá estado, señalización y disponibilidad; acompañá a los niños cerca de la avenida y la fuente.'], ['Con necesidades de movilidad', 'Prepará el recorrido antes', 'Turismo municipal documenta rampas de esquina y sendas podotáctiles. No auditamos las superficies, cruces ni la continuidad actual de un recorrido sin escalones.']],
 transportTitle: 'Cómo llegar a Av. Colón', transportText: 'Usá “Plaza Colón, Av. Colón, Alberdi, Córdoba, Argentina” como destino. Confirmá el recorrido del día sin depender de una línea o duración no verificada.',
 transport: [['Desde el aeropuerto o la terminal', 'Consultá con el operador el recorrido vigente, equipaje, tarifa y punto de descenso. Esta guía no verifica un servicio aeroportuario concreto.'], ['Colectivo urbano', 'Usá el planificador vigente del servicio local con tu origen real. Comprobá recorrido, paradas, tarifa y desvíos antes de salir.'], ['Taxi o remís', 'Indicá el destino completo en Córdoba, Argentina, y acordá un descenso permitido. Confirmá la tarifa o modalidad de cobro del servicio.'], ['A pie, en bicicleta o en auto', 'Revisá cruces y señalización para tu recorrido. Confirmá por separado las condiciones de estacionamiento; esta guía no lo ofrece ni garantiza disponibilidad.']],
 servicesTitle: 'Confirmar los detalles prácticos', services: [['Horarios', 'La ficha de Google Maps consultada el 22 de octubre de 2026 no proporcionaba horarios. Confirmá restricciones, obras o eventos del día; esta guía no garantiza acceso las 24 horas.'], ['Baños y agua potable', 'No contamos con una verificación actual de sanitarios públicos o puntos de agua disponibles en la plaza. Prevé estas necesidades antes de llegar.'], ['Acceso e interiores cercanos', 'Turismo municipal describe una plaza pública. Consultá las condiciones de eventos y las reglas propias de edificios o espacios que sumes al recorrido.']],
 nearbyTitle: 'Continuar por Alberdi', nearbyIntro: 'Turismo municipal propone estos lugares como paradas independientes de un paseo más amplio. Confirmá la ubicación, agenda y condiciones de acceso de cada destino antes de sumarlo.',
 nearby: [['Iglesia María Auxiliadora', 'Un hito incluido en el relato municipal sobre Alberdi.'], ['Isla de los Patos', 'Un destino al aire libre independiente dentro del recorrido barrial ampliado.'], ['Plaza de la Música', 'Un antiguo entorno industrial citado por la fuente municipal; consultá su agenda propia.']],
 faqTitle: 'Preguntas antes del paseo', faq: [['¿Dónde queda esta Plaza Colón?', 'Sobre Av. Colón en Alberdi, ciudad y provincia de Córdoba, Argentina. La dirección de referencia de Google Maps es X5000EPZ Córdoba. Usá la ficha enlazada para planificar el recorrido.'], ['¿Abre las 24 horas?', 'No tenemos horarios verificados. La ficha de Google Maps consultada el 22 de octubre de 2026 no proporcionaba horarios. Confirmá restricciones o eventos antes de visitar.'], ['¿Qué conviene observar?', 'El relato municipal destaca la fuente de hierro fundido, las esculturas, el arbolado y el paisaje remodelado por Carlos David en la década de 1950.'], ['¿Están disponibles el sector de infancias y los senderos accesibles?', 'Turismo municipal informa un patio de las infancias, canil, rampas de esquina y sendas podotáctiles. No es una inspección actual: comprobá las condiciones al llegar.'], ['¿Cuánto tiempo conviene reservar?', 'Esta guía sugiere 45–75 minutos para observar con calma fuente, árboles y perímetro. Adaptá el tiempo a tu ritmo y las condiciones; no es la duración de una visita oficial.']],
 sourceTitle: 'Fuentes y fecha', sourceText: 'Información pública del lugar consultada el 22 de octubre de 2026. La valoración de Google Maps es una referencia de terceros, no una puntuación recogida por esta guía, y puede cambiar.',
 photoText: 'Fotografía de referencia de 2022: puede diferir del estado actual. Se redujo el tamaño y la página puede aplicar recortes o ajustes de color.',
};
const ids = en ? {history:'history',visit:'visit',transport:'transport',services:'services',nearby:'nearby'} : {history:'historia',visit:'visita',transport:'transporte',services:'servicios',nearby:'alrededores'};
const faqItems = t.faq.map(([question,answer]) => ({question,answer}));
---
<BaseLayout title={t.title} description={t.description} locale={locale} faqItems={faqItems} attraction={true}>
  <div id="top"></div><SiteHeader locale={locale} />
  <main id="content" class="visitor-guide">
    <section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src="/images/plaza-2022.jpg" alt={en ? 'View of Plaza Colón towards María Auxiliadora Parish in 2022' : 'Vista de Plaza Colón hacia la parroquia María Auxiliadora en 2022'} fetchpriority="high" width="1355" height="1800" /><div class="hero-scrim"></div><div class="hero-copy"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">Plaza Colón<br /><em>Córdoba</em></h1><p class="hero-intro">{t.intro}</p><div class="hero-actions"><a class="button button-bronze" href={`#${ids.visit}`}>{t.plan}</a><a class="button button-ghost" href="#map">{t.map}</a></div></div><div class="hero-plaque"><span>{t.rename}</span><strong>1892</strong><small>{t.former}</small></div></section>
    <section class="quick-facts" aria-label={en ? 'Visit facts' : 'Datos de visita'}>{t.facts.map(([label,value]) => <div><span>{label}</span><b>{value}</b></div>)}</section>
    <section class="photo-source section-wrap" id="photo-credits"><h2>{en ? 'Photograph credits' : 'Créditos de fotografías'}</h2><p>{t.photoText}</p><p>2022: Santi Cba · <a href="https://commons.wikimedia.org/wiki/File:Plaza_Col%C3%B3n,_C%C3%B3rdoba,_Argentina.jpg">{en ? 'Original source' : 'Fuente original'}</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>.</p></section>
    <section id={ids.history} class="story-section section-wrap"><div class="section-marker"><span>01</span><i></i></div><div class="story-grid"><div class="story-intro"><p class="eyebrow">{en ? 'Municipal heritage account' : 'Relato patrimonial municipal'}</p><h2>{t.history}</h2><p class="lead">{t.historyIntro}</p><a class="inline-link" href={source}>{en ? 'Read the municipal source' : 'Leer la fuente municipal'} ↗</a></div><figure class="photo-frame photo-tall"><img src="/images/plaza-2022.jpg" alt={en ? 'View from Avellaneda street towards María Auxiliadora Parish in 2022' : 'Vista desde calle Avellaneda hacia la parroquia María Auxiliadora en 2022'} loading="lazy" width="1355" height="1800" /><figcaption>Santi Cba · 2022 · CC0 · <a href="#photo-credits">{en ? 'Source and notice' : 'Fuente y aviso'}</a></figcaption></figure><div class="story-notes">{t.timeline.map(([year,text]) => <article><b>{year}</b><p>{text}</p></article>)}</div></div></section>
    <section class="botanical-section"><div class="botanical-copy"><p class="eyebrow">{en ? 'Trees and landscape' : 'Árboles y paisaje'}</p><h2>{t.botTitle}</h2><p>{t.botText}</p></div></section>
    <section id={ids.visit} class="section-wrap"><div class="section-marker"><span>02</span><i></i></div><h2>{t.visitTitle}</h2><p class="lead">{t.visitText}</p><div class="guide-cards">{t.visits.map(([title,time,text]) => <article class="guide-card"><p class="eyebrow">{time}</p><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <WeatherSection locale={locale} />
    <section id={ids.transport} class="section-wrap"><h2>{t.transportTitle}</h2><p class="lead">{t.transportText}</p><div class="guide-cards">{t.transport.map(([title,text]) => <article class="guide-card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section id={ids.services} class="section-wrap"><h2>{t.servicesTitle}</h2><div class="guide-cards">{t.services.map(([title,text]) => <article class="guide-card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section id={ids.nearby} class="section-wrap"><h2>{t.nearbyTitle}</h2><p>{t.nearbyIntro}</p><div class="guide-cards">{t.nearby.map(([title,text]) => <article class="guide-card"><h3>{title}</h3><p>{text}</p><a class="inline-link" href={source}>{en ? 'Municipal neighbourhood account' : 'Relato barrial municipal'} ↗</a></article>)}</div></section>
    <section id="map" class="map-section"><div class="map-copy"><p class="eyebrow light">{t.map}</p><h2>Plaza Colón<br /><em>Córdoba, Argentina</em></h2><p>Av. Colón · X5000EPZ<br />Alberdi · Córdoba</p><a class="button button-bronze" href="https://maps.app.goo.gl/VFVHXX42gPEcgbg76">{en ? 'Open Google Maps' : 'Abrir Google Maps'}</a></div><iframe title={en ? 'Map of Plaza Colón in Córdoba, Argentina' : 'Mapa de Plaza Colón en Córdoba, Argentina'} src="https://www.google.com/maps?q=Plaza+Col%C3%B3n+C%C3%B3rdoba+Argentina&output=embed" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></section>
    <section id="faq" class="section-wrap"><h2>{t.faqTitle}</h2><div class="faq-list">{t.faq.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section id="sources" class="section-wrap"><h2>{t.sourceTitle}</h2><p>{t.sourceText}</p><ul><li><a href={source}>{en ? 'Córdoba municipal tourism: Plaza Colón' : 'Turismo municipal de Córdoba: Plaza Colón'}</a></li><li><a href="https://turismo.cordoba.gob.ar/tres-plazas-de-tradicionales-barrios-de-cordoba-con-mucha-historia/">{en ? 'Municipal account of three neighbourhood squares' : 'Relato municipal sobre tres plazas barriales'}</a></li><li><a href="https://maps.app.goo.gl/VFVHXX42gPEcgbg76">Google Maps · 22/10/2026 · {en ? 'third-party rating snapshot' : 'referencia de valoración externa'}</a></li></ul></section>
  </main><SiteFooter locale={locale} />
</BaseLayout>
