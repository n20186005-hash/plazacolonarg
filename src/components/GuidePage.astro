---
/**
 * Design reminder — Herbario de hierro remains the shared aesthetic. Copy is a factual, neutral guide:
 * Spanish is the local default; English is a complete parallel route, never mixed in visible UI.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props { locale: 'es' | 'en'; }
const { locale } = Astro.props;
const en = locale === 'en';
const t = en ? {
  title: 'Plaza Colón Córdoba — Visitor guide to Alberdi', description: 'A public-interest guide to Plaza Colón Córdoba: heritage, tree canopy, access, visitor planning and place-name clarification for international travellers.',
  eyebrow: 'Córdoba, Argentina · Alberdi neighbourhood', hero: 'The fountain is not alone.', heroEm: 'The promenade holds it.', intro: 'A square of cast iron, water and tree shade: a heritage landmark in Alberdi, a short urban journey from central Córdoba.', plan: 'Plan your visit', map: 'Find it on the map', founded: 'Opened', plaque: 'as Plaza Juárez Celman', credit: 'Plaza Colón photograph · municipal tourism archive',
  facts: [['Visit type', 'Urban heritage walk'], ['Access', 'Public space · no entry fee listed'], ['Suggested time', '45–75 min'], ['Map rating', '4.1 / 5 · 18,790 reviews']],
  historyLabel: 'A public square with a long material memory', history: 'Read the iron, water and shade', historyLead: 'Plaza Colón opened in 1888 as Plaza Juárez Celman and took its present name in 1892. Its cast-iron fountain and four Parisian lamps make the centre a document of late-19th-century public space, not just an ornamental stop.', source: 'Read the municipal tourism record', timeline: [['1888', 'The square opens amid Córdoba’s growth toward Alberdi.'], ['1892', 'It receives the name Plaza Colón, linked to the fourth centenary of the European arrival in the Americas.'], ['1955', 'Architect Carlos David reshapes the planting as a “Mini Botanical Garden”, designed for changing shade and flowering.'], ['Present', 'Conservation work reconnects the fountain, historic lamps, lawns, accessibility elements and everyday recreation.']],
  botLabel: 'Observe the living collection', botTitle: 'Shade is also a form of', botEm: 'heritage.', botText: 'White ash, linden, American red oak, tipu trees and pindo palms help make a changing canopy. Notice the contrast between the central metalwork and the edges of vegetation.',
  visitLabel: 'A measured visit, not a checklist', visitTitle: 'Three ways to', visitEm: 'read the square.', visitText: 'Choose a pace that fits the day. These are editorial routes, not fixed operating instructions; follow access signs and conditions on arrival.',
  routes: [['Quiet morning', '09:00–10:00', 'Enter from Av. Colón, notice the fountain while the square is calmer, then pause beneath the trees.', ['Central fountain', 'Historic lamps and figures', 'Tree canopy']], ['Heritage walk', '45–75 min', 'Read the space as cast iron, water, paving, planting and the legacy of Carlos David.', ['Two-tier fountain', 'Mosaic fontanas', 'Alberdi context']], ['With children', 'Early afternoon', 'Use the designated children’s area as one part of a short walk; active adult supervision remains essential.', ['Corner ramps', 'Children’s area', 'Slow return walk']]],
  practicalLabel: 'Before leaving', practicalTitle: 'Details that make the walk', practicalEm: 'easier.', practical: [['Best time', 'Early morning or the last part of the afternoon usually offers softer light, lower heat and more useful shade.'], ['Suggested duration', 'Allow 45–75 minutes for the fountain, sculpture, trees and a pause. Leave more time if continuing through Alberdi.'], ['Entry / cost', 'The municipal tourism record does not list an entry charge for this public square.'], ['Hours', 'This is an open public space. Events, works or temporary restrictions should be confirmed locally on the day.']],
  transportLabel: 'Getting here with current information', transportTitle: 'Av. Colón, a', transportEm: 'gateway to Alberdi.', transportText: 'Plaza Colón sits on a major urban avenue. Check real-time conditions before setting out, especially when arriving from the airport or during events.', transport: [['Airport', 'Córdoba’s main airport is Ingeniero Aeronáutico Ambrosio Taravella (COR). AeroBus connects the airport with the Nueva Terminal de Ómnibus; from there, continue by urban bus or licensed taxi/remís. Verify the day’s route and service conditions before travel.', 'Airport and AeroBus information ↗', 'https://yoparticipo.cordoba.gob.ar/oidp/transportes/'], ['Urban bus', 'Use the municipal Tu Bondi tool with your real origin and destination. It helps identify routes, arrivals, transfers and diversions, without this guide guessing a line number.', 'Open Tu Bondi ↗', 'https://cordoba.gob.ar/tu-bondi/'], ['Taxi / remís', 'Give the driver “Plaza Colón, Av. Colón, barrio Alberdi”. Ask to stop safely beside the avenue and check the traffic environment before alighting.', 'Open the map ↘', '#map'], ['Walking / cycling', 'From the central area, Av. Colón is the direct urban axis. The square has documented corner ramps and tactile paving; surfaces and crossings still merit an on-site check.', 'See location ↘', '#map']],
  servicesLabel: 'Facilities and everyday needs', servicesTitle: 'Plan the small things', servicesEm: 'without assumptions.', servicesText: 'This guide lists useful categories rather than businesses. Availability, hours, prices and accessibility can change, so treat the following as planning prompts.', services: [['Toilets / drinking water', 'No current municipal source consulted for this guide confirms an on-site public toilet or drinking-water service. Plan before arriving and ask locally if needed.'], ['Parking', 'Private garages and street parking may exist in the wider area. Do not rely on spaces at the square edge, block ramps or stop in unsafe zones.'], ['Food and rest', 'The Av. Colón and Alberdi environment includes cafés, casual restaurants and take-away food types. Choose according to your dietary needs and confirm opening hours yourself.'], ['Accommodation and essentials', 'The wider central area offers lodging types, small supermarkets and pharmacies. Select by walking access, accessibility needs and current hours rather than rankings.'], ['Fuel and electric charging', 'Fuel stations and charging points belong to the broader urban network, not necessarily the square itself. Check a live map before driving.'], ['Accessibility', 'The restoration added corner ramps and tactile paving. The practical quality of each route can vary with pavement, weather and works; travel with assistance where required.']],
  mapTitle: 'Plaza Colón', mapAction: 'Open in Google Maps', nearbyLabel: 'Continue through Alberdi', nearbyTitle: 'The square is one', nearbyEm: 'chapter of the neighbourhood.', nearbyText: 'Municipal tourism material places Plaza Colón within a broader Alberdi walk. Consider nearby civic, cultural and green places as independent stops; check schedules and access conditions directly.', sights: [['Isla de los Patos', 'A green continuation for an outdoor walk.'], ['Plaza de la Música', 'A recovered industrial setting with cultural programming.'], ['Belgrano stadium area', 'A reference point for Alberdi’s sporting identity.'], ['María Auxiliadora church', 'One of the neighbourhood’s historic landmarks.']],
  methodLabel: 'Interpretive note', methodTitle: 'Evidence before legend.', methodText: 'The documented story is already substantial: Parisian cast iron, a changing botanical design and neighbourhood growth. This guide does not invent legends or attribute oral stories without a traceable public source. Future additions will identify their source and whether they are archival evidence, local memory or interpretation.',
  faqLabel: 'Frequently asked questions', faqTitle: 'What to know before', faqEm: 'you arrive.', faq: [['Is there an entry fee?', 'Plaza Colón is an outdoor public square. The municipal tourism page consulted for this guide does not list an entry charge.'], ['How long should I allow?', 'Plan 45–75 minutes for the fountain, sculptures, trees and a pause; add time for an Alberdi walk.'], ['How do I get there from the airport?', 'AeroBus connects Córdoba airport with the Nueva Terminal de Ómnibus. Continue with an urban bus, taxi or remís after checking current routes.'], ['Can I use public transport?', 'Yes. Use Tu Bondi for current routes, arrival times and diversions based on your actual origin.'], ['Are toilets, food and parking available?', 'Plan these needs by category in the surrounding urban area. This independent guide does not certify on-site services or recommend businesses.'], ['Is the route accessible?', 'The square has documented ramps and tactile paving. Check crossings and surface conditions on arrival, especially after rain or works.']],
  sourcesLabel: 'Public reference channels', sources: [['Turismo Córdoba', 'Historical context and visitor record', 'https://turismo.cordoba.gob.ar/plaza-colon/'], ['Municipalidad de Córdoba', 'Public works, urban services and city information', 'https://cordoba.gob.ar/'], ['Tu Bondi', 'Live urban public transport planning', 'https://cordoba.gob.ar/tu-bondi/'], ['Airport / AeroBus information', 'Airport and airport-to-terminal connection', 'https://yoparticipo.cordoba.gob.ar/oidp/transportes/']],
} : {
  title: 'Plaza Colón — Guía de visita en Alberdi, Córdoba', description: 'Guía de interés público sobre patrimonio, arbolado, acceso y planificación de Plaza Colón.',
  eyebrow: 'Córdoba, Argentina · Barrio Alberdi', hero: 'La fuente no está sola.', heroEm: 'El paseo la rodea.', intro: 'Una plaza de hierro, agua y sombra: pieza patrimonial de Alberdi, a pocas cuadras urbanas del centro de Córdoba.', plan: 'Planear la visita', map: 'Ubicarme en el mapa', founded: 'Inaugurada', plaque: 'como Plaza Juárez Celman', credit: 'Fotografía de Plaza Colón · archivo turístico municipal',
  facts: [['Tipo de visita', 'Paseo urbano y patrimonial'], ['Acceso', 'Espacio público · sin tarifa indicada'], ['Tiempo sugerido', '45–75 min'], ['En Maps', '4,1 / 5 · 18.790 reseñas']],
  historyLabel: 'Una plaza con larga memoria material', history: 'Leer el hierro, el agua y la sombra', historyLead: 'La Plaza Colón se inauguró en 1888 como Plaza Juárez Celman y recibió su nombre actual en 1892. La fuente de hierro fundido y las cuatro farolas llegadas de París hacen de su centro un documento del espacio público de fines del siglo XIX, no solo una parada ornamental.', source: 'Leer la ficha turística municipal', timeline: [['1888', 'La plaza se inaugura durante el crecimiento de Córdoba hacia Alberdi.'], ['1892', 'Recibe el nombre Plaza Colón, vinculado al cuarto centenario de la llegada europea a América.'], ['1955', 'El arquitecto Carlos David reorganiza la vegetación como un “Mini Jardín Botánico”, pensado para alternar sombra y floración.'], ['Actualidad', 'La conservación vuelve a conectar fuente, farolas históricas, césped, accesibilidad y recreación cotidiana.']],
  botLabel: 'Observar la colección viva', botTitle: 'La sombra también es', botEm: 'patrimonio.', botText: 'Fresnos blancos, tilos, robles rojos americanos, tipas y palmeras pindó construyen una copa cambiante. Mirá el contraste entre la metalurgia del centro y los bordes de vegetación.',
  visitLabel: 'Una visita medida, no una lista de tareas', visitTitle: 'Tres maneras de', visitEm: 'leer la plaza.', visitText: 'Elegí un ritmo que funcione para el día. Son recorridos editoriales, no instrucciones operativas: seguí la señalización y las condiciones de acceso al llegar.',
  routes: [['Mañana tranquila', '09:00–10:00', 'Entrá por Av. Colón, mirá la fuente con menos movimiento y terminá bajo el arbolado.', ['Fuente central', 'Farolas y figuras', 'Copa arbórea']], ['Paseo patrimonial', '45–75 min', 'Leé el espacio como hierro fundido, agua, solados, plantación y huellas de Carlos David.', ['Fuente de dos bandejas', 'Fontanas de venecitas', 'Contexto de Alberdi']], ['Con infancias', 'Tarde temprana', 'Usá el sector destinado a las infancias como parte de una vuelta breve; el acompañamiento adulto sigue siendo esencial.', ['Rampas de esquina', 'Sector de infancias', 'Regreso pausado']]],
  practicalLabel: 'Antes de salir', practicalTitle: 'Datos que hacen el paseo', practicalEm: 'más sencillo.', practical: [['Mejor momento', 'Primera hora o la última franja de la tarde suelen ofrecer luz suave, menor calor y sombra útil.'], ['Duración sugerida', 'Calculá 45–75 minutos para fuente, esculturas, arbolado y una pausa. Sumá tiempo si seguís por Alberdi.'], ['Entrada / costo', 'La ficha turística municipal no señala tarifa de ingreso para esta plaza pública.'], ['Horario', 'Es un espacio público abierto. Actividades, obras o restricciones temporales deben confirmarse en el lugar el mismo día.']],
  transportLabel: 'Llegar con información actual', transportTitle: 'Avenida Colón, una', transportEm: 'puerta de Alberdi.', transportText: 'Plaza Colón se ubica sobre una avenida urbana principal. Revisá las condiciones en tiempo real antes de salir, especialmente si llegás desde el aeropuerto o en días de eventos.', transport: [['Aeropuerto', 'El aeropuerto principal de Córdoba es el Internacional Ingeniero Aeronáutico Ambrosio Taravella (COR). AeroBus conecta el aeropuerto con la Nueva Terminal de Ómnibus; desde allí continuá en colectivo urbano o taxi/remís habilitado. Verificá el recorrido y el servicio del día.', 'Información de aeropuerto y AeroBus ↗', 'https://yoparticipo.cordoba.gob.ar/oidp/transportes/'], ['Colectivo urbano', 'Usá la herramienta municipal Tu Bondi con origen y destino reales. Permite identificar recorridos, arribos, combinaciones y desvíos sin que esta guía adivine una línea.', 'Abrir Tu Bondi ↗', 'https://cordoba.gob.ar/tu-bondi/'], ['Taxi / remís', 'Indicá “Plaza Colón, Av. Colón, barrio Alberdi”. Pedí una bajada segura sobre la avenida y mirá el tránsito antes de descender.', 'Abrir mapa ↘', '#map'], ['A pie / en bici', 'Desde el área central, Av. Colón es el eje urbano directo. La plaza tiene rampas de esquina y sendas podotáctiles documentadas; las veredas y cruces merecen revisión en el momento.', 'Ver ubicación ↘', '#map']],
  servicesLabel: 'Servicios y necesidades cotidianas', servicesTitle: 'Planear lo pequeño', servicesEm: 'sin asumir.', servicesText: 'Esta guía enumera categorías útiles, no comercios. La disponibilidad, horarios, precios y accesibilidad cambian; tomá estos puntos como una lista de planificación.', services: [['Baños / agua', 'Ninguna fuente municipal actual consultada para esta guía confirma baños públicos o agua potable dentro de la plaza. Planificá antes de llegar y consultá localmente si lo necesitás.'], ['Estacionamiento', 'Puede haber cocheras privadas y estacionamiento en vía pública en el entorno. No dependas de lugares junto a la plaza, no bloquees rampas ni te detengas en zonas inseguras.'], ['Comida y descanso', 'El eje Av. Colón y Alberdi reúne categorías como cafés, restaurantes informales y comida para llevar. Elegí según tus necesidades y confirmá horarios por tu cuenta.'], ['Alojamiento y compras', 'El área central ampliada ofrece tipos de alojamiento, mercados pequeños y farmacias. Priorizá acceso peatonal, necesidad de movilidad y horario real, no rankings.'], ['Combustible y carga eléctrica', 'Las estaciones de servicio y carga pertenecen a la red urbana amplia, no necesariamente a la plaza. Consultá un mapa actualizado antes de conducir.'], ['Accesibilidad', 'La recuperación incorporó rampas de esquina y sendas podotáctiles. La calidad práctica del recorrido puede variar por vereda, clima u obras; viajá con apoyo cuando lo requieras.']],
  mapTitle: 'Plaza Colón', mapAction: 'Abrir en Google Maps', nearbyLabel: 'Seguir por Alberdi', nearbyTitle: 'La plaza es un capítulo', nearbyEm: 'del barrio.', nearbyText: 'El material turístico municipal ubica a Plaza Colón dentro de un paseo más amplio por Alberdi. Considerá los lugares verdes, culturales y cívicos cercanos como paradas independientes; comprobá horarios y accesos directamente.', sights: [['Isla de los Patos', 'Una continuidad verde para extender el paseo al aire libre.'], ['Plaza de la Música', 'Un entorno industrial recuperado con programación cultural.'], ['Entorno del estadio de Belgrano', 'Un punto de referencia para reconocer la identidad deportiva de Alberdi.'], ['Iglesia María Auxiliadora', 'Uno de los hitos históricos del barrio.']],
  methodLabel: 'Nota interpretativa', methodTitle: 'Evidencia antes que leyenda.', methodText: 'La historia documentada ya es sustantiva: hierro parisino, diseño botánico cambiante y crecimiento barrial. Esta guía no inventa leyendas ni atribuye relatos orales sin una fuente pública trazable. Las futuras ampliaciones identificarán si se trata de archivo, memoria local o interpretación.',
  faqLabel: 'Preguntas frecuentes', faqTitle: 'Lo que conviene saber antes', faqEm: 'de llegar.', faq: [['¿Hay que pagar entrada?', 'Plaza Colón es una plaza pública al aire libre. La página turística municipal consultada no señala tarifa de ingreso.'], ['¿Cuánto tiempo conviene reservar?', 'Calculá 45–75 minutos para la fuente, esculturas, arbolado y una pausa; sumá tiempo para recorrer Alberdi.'], ['¿Cómo llego desde el aeropuerto?', 'AeroBus conecta el aeropuerto de Córdoba con la Nueva Terminal de Ómnibus. Después continuá en colectivo urbano, taxi o remís tras revisar recorridos actuales.'], ['¿Se puede llegar en transporte público?', 'Sí. Usá Tu Bondi para recorridos, horarios de llegada y desvíos actualizados desde tu punto de origen.'], ['¿Hay baños, comida y estacionamiento?', 'Planificá estas necesidades por categorías en el entorno urbano. Esta guía independiente no certifica servicios dentro de la plaza ni recomienda comercios.'], ['¿El recorrido es accesible?', 'Hay rampas y sendas podotáctiles documentadas. Revisá cruces y superficies al llegar, especialmente con lluvia u obras.']],
  sourcesLabel: 'Canales públicos de referencia', sources: [['Turismo Córdoba', 'Historia y ficha de visita', 'https://turismo.cordoba.gob.ar/plaza-colon/'], ['Municipalidad de Córdoba', 'Obra pública, servicios urbanos e información de la ciudad', 'https://cordoba.gob.ar/'], ['Tu Bondi', 'Planificación de transporte urbano en tiempo real', 'https://cordoba.gob.ar/tu-bondi/'], ['Aeropuerto / AeroBus', 'Aeropuerto y conexión aeropuerto–terminal', 'https://yoparticipo.cordoba.gob.ar/oidp/transportes/']],
};
const faqItems = t.faq.map(([question, answer]) => ({ question, answer }));
const ids = en ? { history: 'history', visit: 'visit', transport: 'transport', services: 'services', nearby: 'nearby' } : { history: 'historia', visit: 'visita', transport: 'transporte', services: 'servicios', nearby: 'alrededores' };
const comparison = en ? {
  label: 'About & location clarification',
  title: 'Plaza Colón around the world,',
  em: 'grounded in Córdoba.',
  disambiguation: 'This guide is dedicated only to Plaza Colón Córdoba, the public square on Av. Colón, X5000EPZ, in the Alberdi neighbourhood of Córdoba, Argentina. It is not the similarly named plaza in Madrid, the Old San Juan gateway in Puerto Rico, or the coastal-city square in Mar del Plata. The exact map point for this guide is Córdoba at -31.4092824, -64.1957511.',
  table: [
    ['Plaza Colón Córdoba, Argentina', 'Alberdi, Córdoba', 'A late-19th-century public square whose identity is carried by its Parisian cast-iron fountain, historic lamps, tree canopy and everyday neighbourhood use.', 'A quieter heritage-and-leisure setting, with the wider Alberdi historical landscape including Iglesia María Auxiliadora.'],
    ['Plaza de Colón, Madrid, Spain', 'Central Madrid', 'A major civic landmark associated with the Columbus monument and the large Spanish flag.', 'Monument-and-flag urban landmark; this is the “Plaza Colón vs Madrid” distinction visitors most often need.'],
    ['Plaza Colón, San Juan, Puerto Rico', 'Entrance to walled Old San Juan', 'A Columbus-monument plaza at the landward approach to the historic walled city.', 'Gateway to Old San Juan, rather than an Alberdi neighbourhood garden square.'],
    ['Plaza Colón, Mar del Plata, Argentina', 'Mar del Plata', 'A central public square in a major Argentine coastal visitor city.', 'The key Plaza Colón Argentina difference: coastal-city context in Mar del Plata versus the inland, heritage-and-tree-shade character of Córdoba.'],
  ],
  note: 'For factual clarity, this page does not attribute Plaza Colón Córdoba to Carlos Thays. Public descriptions used by this guide associate the 1955 planting redesign with architect Carlos David; operational and heritage details should always be checked against current local sources.',
  references: [['Madrid Tourism', 'https://www.esmadrid.com/en/tourist-information/plaza-colon'], ['Discover Puerto Rico', 'https://www.discoverpuertorico.com/profile/plaza-colon-san-juan/8039'], ['Turismo Mar del Plata', 'https://www.turismomardelplata.gob.ar/']],
} : null;
---
<BaseLayout title={t.title} description={t.description} locale={locale} faqItems={faqItems}>
  <div id="top"></div><SiteHeader locale={locale} />
  <main id="content">
    <svg class="water-thread" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true"><path class="water-thread-shadow" d="M52 0 C92 58 10 105 54 166 S94 271 49 333 S5 442 52 500 S90 603 46 668 S13 772 53 834 S83 930 46 1000" /><path class="water-thread-line" d="M52 0 C92 58 10 105 54 166 S94 271 49 333 S5 442 52 500 S90 603 46 668 S13 772 53 834 S83 930 46 1000" /><g class="water-stations"><circle cx="53" cy="142" r="4" /><circle cx="50" cy="315" r="4" /><circle cx="51" cy="490" r="4" /><circle cx="48" cy="663" r="4" /><circle cx="52" cy="838" r="4" /></g></svg>
    <section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src="/images/plaza-colon-fuente-atardecer.jpg" alt={en ? 'Cast-iron fountain at Plaza Colón in Córdoba' : 'Fuente de hierro fundido de Plaza Colón en Córdoba'} /><div class="hero-scrim"></div><div class="hero-copy"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">{t.hero}<br /><em>{t.heroEm}</em></h1><p class="hero-intro">{t.intro}</p><div class="hero-actions"><a class="button button-bronze" href={`#${ids.visit}`}>{t.plan}</a><a class="button button-ghost" href="#map">{t.map}</a></div></div><div class="hero-plaque"><span>{t.founded}</span><strong>1888</strong><small>{t.plaque}</small></div><p class="photo-credit">{t.credit}</p></section>
    <section class="quick-facts" aria-label={en ? 'Visit facts' : 'Datos de visita'}>{t.facts.map(([label, value]) => <div><span>{label}</span><b>{value}</b></div>)}</section>
    <section id={ids.history} class="story-section section-wrap"><div class="section-marker"><span>01</span><i></i></div><div class="story-grid"><div class="story-intro"><p class="eyebrow">{t.historyLabel}</p><h2>{t.history}</h2><p class="lead">{t.historyLead}</p><a class="inline-link" href="https://turismo.cordoba.gob.ar/plaza-colon/" target="_blank" rel="noreferrer">{t.source} ↗</a></div><figure class="photo-frame photo-tall"><img src="/images/plaza-colon-fuente-y-parque.jpeg" alt={en ? 'Plaza Colón green layout seen from above' : 'Traza verde de Plaza Colón vista desde arriba'} loading="lazy" /><figcaption>{en ? 'A green urban trace within the city.' : 'Una traza verde dentro de la ciudad.'}</figcaption></figure><div class="story-notes">{t.timeline.map(([year, text]) => <article><b>{year}</b><p>{text}</p></article>)}</div></div><div class="ironwork" aria-hidden="true"></div></section>
    <section class="botanical-section"><div class="botanical-copy"><p class="eyebrow">{t.botLabel}</p><h2>{t.botTitle}<br /><em>{t.botEm}</em></h2><p>{t.botText}</p></div><div class="species-list" aria-label={en ? 'Species to notice' : 'Especies para observar'}>{['Fresno blanco / White ash', 'Tilo / Linden', 'Roble rojo americano / American red oak', 'Tipa / Tipu tree', 'Palmera pindó / Pindo palm'].map((item, i) => <span><i>0{i + 1}</i>{en ? item.split(' / ')[1] : item.split(' / ')[0]}</span>)}</div><div class="botanical-vignette" aria-hidden="true"></div></section>
    <section id={ids.visit} class="planner-section section-wrap"><div class="section-marker"><span>02</span><i></i></div><div class="planner-heading"><p class="eyebrow">{t.visitLabel}</p><h2>{t.visitTitle}<br /><em>{t.visitEm}</em></h2><p>{t.visitText}</p></div><div class="route-notes">{t.routes.map(([title, time, text, steps], i) => <article><span>0{i + 1}</span><p class="route-time">{time}</p><h3>{title}</h3><p>{text}</p><ul>{(steps as string[]).map((step) => <li>{step}</li>)}</ul></article>)}</div></section>
    <section class="practical-section"><div class="practical-photo"><img src="/images/plaza-colon-vista-aerea.jpeg" alt={en ? 'Plaza Colón within the urban fabric of Córdoba' : 'Plaza Colón dentro de la trama urbana de Córdoba'} loading="lazy" /></div><div class="practical-copy"><p class="eyebrow">{t.practicalLabel}</p><h2>{t.practicalTitle}<br /><em>{t.practicalEm}</em></h2><dl class="practical-list">{t.practical.map(([term, definition]) => <div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl></div></section>
    <section id={ids.transport} class="getting-there section-wrap"><div class="section-marker"><span>03</span><i></i></div><div class="arrival-intro"><p class="eyebrow">{t.transportLabel}</p><h2>{t.transportTitle}<br /><em>{t.transportEm}</em></h2><p>{t.transportText}</p></div><div class="mobility-grid mobility-grid-four">{t.transport.map(([title, text, action, href], i) => <article><span class="mobility-icon">0{i + 1}</span><h3>{title}</h3><p>{text}</p><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined}>{action}</a></article>)}</div></section>
    <section id={ids.services} class="services-section section-wrap"><div class="section-marker"><span>04</span><i></i></div><div class="services-heading"><p class="eyebrow">{t.servicesLabel}</p><h2>{t.servicesTitle}<br /><em>{t.servicesEm}</em></h2><p>{t.servicesText}</p></div><div class="service-notes">{t.services.map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section id="map" class="map-section"><div class="map-copy"><p class="eyebrow light">{en ? 'Meeting point' : 'Punto de encuentro'}</p><h2>{t.mapTitle}<br /><em>Córdoba</em></h2><p>Av. Colón · X5000EPZ<br />Córdoba, Argentina</p><a class="button button-bronze" href="https://maps.app.goo.gl/VFVHXX42gPEcgbg76" target="_blank" rel="noreferrer">{t.mapAction}</a></div><iframe title={en ? 'Map of Plaza Colón, Córdoba' : 'Mapa de Plaza Colón, Córdoba'} src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d24244.142221729235!2d-64.21480551284176!3d-31.409282399999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9432993038308dbd%3A0x6b19099e5c73a073!2sPlaza%20Col%C3%B3n!5e1!3m2!1ses-AR!2sar!4v1787715699114!5m2!1ses-AR!2sar" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></section>
    <section id={ids.nearby} class="nearby-section section-wrap"><div class="section-marker"><span>05</span><i></i></div><div class="nearby-heading"><p class="eyebrow">{t.nearbyLabel}</p><h2>{t.nearbyTitle}<br /><em>{t.nearbyEm}</em></h2></div><div class="nearby-columns"><div class="nearby-food"><p class="section-label">{en ? 'How to use this area' : 'Cómo usar este entorno'}</p><h3>{en ? 'A neutral neighbourhood guide.' : 'Una guía barrial neutral.'}</h3><p>{t.nearbyText}</p><p class="disclaimer">{en ? 'Schedules, access and programming change. Confirm directly with the place or public channel before making a special trip.' : 'Los horarios, accesos y programas cambian. Confirmá directamente con el lugar o canal público antes de hacer un viaje especial.'}</p></div><div class="nearby-sights"><p class="section-label">{en ? 'Places named by municipal tourism' : 'Lugares citados por Turismo Córdoba'}</p><ul>{t.sights.map(([title, text], i) => <li><span>0{i + 1}</span><div><b>{title}</b><p>{text}</p></div></li>)}</ul></div></div></section>
    <section class="method-section"><div><p class="eyebrow">{t.methodLabel}</p><h2>{t.methodTitle}</h2></div><p>{t.methodText}</p></section>
    {comparison && <section id="place-comparison" class="comparison-section section-wrap" aria-labelledby="comparison-title"><div class="section-marker"><span>06</span><i></i></div><div class="comparison-intro"><p class="eyebrow">{comparison.label}</p><h2 id="comparison-title">{comparison.title}<br /><em>{comparison.em}</em></h2><p>{comparison.disambiguation}</p></div><div class="comparison-table-wrap"><table><caption>Plaza Colón Around the World vs. Córdoba</caption><thead><tr><th scope="col">Place</th><th scope="col">Location</th><th scope="col">Defining character</th><th scope="col">How it differs from Córdoba</th></tr></thead><tbody>{comparison.table.map(([place, location, character, difference]) => <tr><th scope="row">{place}</th><td>{location}</td><td>{character}</td><td>{difference}</td></tr>)}</tbody></table></div><aside class="comparison-note"><span>Method note</span><p>{comparison.note}</p><div>{comparison.references.map(([name, href]) => <a href={href} target="_blank" rel="noreferrer">{name} ↗</a>)}</div></aside></section>}
    <section id="faq" class="faq-section"><div class="faq-heading"><p class="eyebrow">{t.faqLabel}</p><h2>{t.faqTitle}<br /><em>{t.faqEm}</em></h2></div><div class="faq-list">{t.faq.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="sources-section"><p class="eyebrow">{t.sourcesLabel}</p><div>{t.sources.map(([title, text, href]) => <a href={href} target="_blank" rel="noreferrer"><b>{title}</b><span>{text}</span><i>↗</i></a>)}</div></section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
