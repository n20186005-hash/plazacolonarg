  mapTitle: 'Plaza Colón', mapAction: 'Abrir en Google Maps', nearbyLabel: 'Seguir por Alberdi', nearbyTitle: 'La plaza es un capítulo', nearbyEm: 'del barrio.', nearbyText: 'El material turístico municipal ubica a Plaza Colón dentro de un paseo más amplio por Alberdi. Considerá los lugares verdes, culturales y cívicos cercanos como paradas independientes; comprobá horarios y accesos directamente.', sights: [['Isla de los Patos', 'Una continuidad verde para extender el paseo al aire libre.'], ['Plaza de la Música', 'Un entorno industrial recuperado con programación cultural.'], ['Entorno del estadio de Belgrano', 'Un punto de referencia para reconocer la identidad deportiva de Alberdi.'], ['Iglesia María Auxiliadora', 'Uno de los hitos históricos del barrio.']],
  methodLabel: 'Nota interpretativa', methodTitle: 'Evidencia antes que leyenda.', methodText: 'La historia documentada ya es sustantiva: hierro parisino, diseño botánico cambiante y crecimiento barrial. Esta guía no inventa leyendas ni atribuye relatos orales sin una fuente pública trazable. Las futuras ampliaciones identificarán si se trata de archivo, memoria local o interpretación.',
  faqLabel: 'Preguntas frecuentes', faqTitle: 'Lo que conviene saber antes', faqEm: 'de llegar.', faq: [['¿Hay que pagar entrada?', 'Plaza Colón es una plaza pública al aire libre. La página turística municipal consultada no señala tarifa de ingreso.'], ['¿Cuánto tiempo conviene reservar?', 'Calculá 45–75 minutos para la fuente, esculturas, arbolado y una pausa; sumá tiempo para recorrer Alberdi.'], ['¿Cómo llego desde el aeropuerto?', 'AeroBus conecta el aeropuerto de Córdoba con la Nueva Terminal de Ómnibus. Después continuá en colectivo urbano, taxi o remís tras revisar recorridos actuales.'], ['¿Se puede llegar en transporte público?', 'Sí. Usá Tu Bondi para recorridos, horarios de llegada y desvíos actualizados desde tu punto de origen.'], ['¿Hay baños, comida y estacionamiento?', 'Planificá estas necesidades por categorías en el entorno urbano. Esta guía independiente no certifica servicios dentro de la plaza ni recomienda comercios.'], ['¿El recorrido es accesible?', 'Hay rampas y sendas podotáctiles documentadas. Revisá cruces y superficies al llegar, especialmente con lluvia u obras.'], ['¿Ésta es la Plaza de Colón de Madrid, España?', 'No. plazacolonarg.com documenta únicamente la Plaza Colón del barrio Alberdi, Córdoba, Argentina (X5000EPZ). La Plaza de Colón homónima de Madrid (España) es un eje cívico con bandera nacional y monumento pétreo a Colón, gestionado por el Ayuntamiento de Madrid.'], ['¿De qué ciudad de Argentina es la Plaza Colón que cubre este sitio?', 'Esta guía trata sobre la Plaza Colón de la ciudad de Córdoba, Provincia de Córdoba, en el barrio Alberdi, sobre la Avenida Colón. No es la Plaza Colón de Mar del Plata, que pertenece a la red turística costera de la Provincia de Buenos Aires, Argentina.'], ['¿Cómo confirmar que estoy leyendo sobre la Plaza Colón correcta y no otra homónima?', 'Verificá tres señales: el barrio es Alberdi, sobre Av. Colón, código postal X5000EPZ, coordenadas -31.40928, -64.19575, identificador de Google Maps 0x9432993038308dbd:0x6b19099e5c73a073. El hito distintivo es la fuente parisina de dos bandejas en hierro fundido y no una estatua pétrea de Colón ni una bandera nacional.'], ['¿Cuál es la ubicación y el código postal exactos de la Plaza Colón documentada en plazacolonarg.com?', 'Ubicación exacta: Avenida Colón, código postal X5000EPZ, Barrio Alberdi, Córdoba, Argentina. En Google Maps buscá: “Plaza Colón, Córdoba, Argentina, X5000EPZ” — esquina de Av. Colón con el eje verde de Alberdi, cerca de la Iglesia María Auxiliadora e Isla de los Patos.']],
  sourcesLabel: 'Canales públicos de referencia', sources: [['Turismo Córdoba', 'Historia y ficha de visita', 'https://turismo.cordoba.gob.ar/plaza-colon/'], ['Municipalidad de Córdoba', 'Obra pública, servicios urbanos e información de la ciudad', 'https://cordoba.gob.ar/'], ['Tu Bondi', 'Planificación de transporte urbano en tiempo real', 'https://turismo.cordoba.gob.ar/turismo-cordoba-capital/tu-bondi-horarios-y-lineas-de-colectivos-de-cordoba/'], ['Aeropuerto / AeroBus', 'Aeropuerto y conexión aeropuerto–terminal', 'https://turismo.cordoba.gob.ar/turismo-cordoba-capital/movilidad/']],
};
const faqItems = t.faq.map(([question, answer]) => ({ question, answer }));
const ids = en ? { history: 'history', visit: 'visit', transport: 'transport', services: 'services', nearby: 'nearby' } : { history: 'historia', visit: 'visita', transport: 'transporte', services: 'servicios', nearby: 'alrededores' };
const comparison = en ? {
  label: 'Know this Plaza Colón — Distinction from homonymous squares worldwide',
  title: 'Know this Plaza Colón,',
  em: 'Córdoba, Argentina.',
  subTitleIntro: 'The square documented on this site is Plaza Colón de barrio Alberdi, Córdoba, Argentina — exact point: Av. Colón, X5000EPZ, coordinates -31.4092824, -64.1957511. Across the Hispanic world the dedication to Cristóbal Colón generates frequent search confusion with three homonymous spaces of very different material character, historical function and urban geography. The following three distinguishing highlights are the quickest way to isolate the Córdoba square.',
  subjectStatement: 'Subject statement · Subject statement (approx. 100 words): plazacolonarg.com is an independent, non-commercial public-interest guide dedicated exclusively to Plaza Colón in the Alberdi neighbourhood of Córdoba, Argentina (X5000EPZ). It does not document, give access information about or represent the Plaza de Colón in Madrid (Spain), Plaza Colón in San Juan (Puerto Rico) or Plaza Colón in Mar del Plata (Buenos Aires Province, Argentina). All dates, photographs and visitor planning and municipal references apply only to the Córdoba Alberdi square.',
  threeDistinctions: [
    ['01', 'Geography: inland Alberdi neighbourhood, not gate, flag-scale monument or coastal plaza', 'This Córdoba square was not built as a monumental gate to a walled city (San Juan), as a national-flag civic-symbol axis (Madrid) or as a coastal tourist-circulation plaza (Mar del Plata). Its 1888 opening and 1892 renaming belong to the municipal expansion of Córdoba toward Alberdi, on an inland neighbourhood axis.'],
    ['02', 'Distinctive landmark identity — Parisian cast-iron material, not a Colón stone monument', 'The defining landmark is not a stone Colón statue or a giant flag, but the Parisian cast-iron two-tier fountain, four Parisian lamps, the 1955 “Mini Botanical Garden” planting design of architect Carlos David, and documented accessibility works (ramps, tactile paving) within everyday Alberdi life.'],
    ['03', 'Urban scale: Alberdi neighbourhood, not a civic-national axis', 'The square belongs to the Alberdi district fabric: within a few urban blocks of Iglesia María Auxiliadora, Isla de los Patos, Plaza de la Música and the Belgrano stadium area. It is not located on a coastal tourist strip, on a national-government avenue or at the landward gate of a walled colonial city.'],
  ],
  leadInFocus: 'Plaza Colón Córdoba, Alberdi, Córdoba, Argentina',
  table: [
    ['Plaza Colón Córdoba, Argentina', 'Argentina · City of Córdoba, Barrio Alberdi', 'Parisian cast-iron two-tier fountain + four Parisian lamps', '1888 (opened as Plaza Juárez Celman); renamed 1892', 'Planted neighbourhood square, botanical edges, everyday Alberdi neighbourhood recreation; Carlos David 1955 Mini Botanical Garden', 'Central fountain Google Maps feature: Google Maps place id 0x9432993038308dbd:0x6b19099e5c73a073; label "Plaza Colón" · -31.40928, -64.19575'],
    ['Plaza de Colón, Madrid, Spain', 'Spain · Madrid, Chamberí / Centro / Salamanca border', 'Tall Neo-Gothic Cristóbal Colón stone monument + 50 m flagpole with world-record Spanish national flag', 'Monument erected 1885; plaza renamed 1893', 'Jardines del Descubrimiento sculptural blocks; heavy traffic tunnels under; monumental civic-symbol scale; urban business district function rather than Alberdi botanical garden square', 'Google Maps labels "Plaza de Colón" Madrid · Paseo de la Castellana, 40.4253, -3.6904'],
    ['Plaza Colón, San Juan, Puerto Rico', 'Puerto Rico (USA) · San Juan, entrance to walled Old San Juan (Puerta de Tierra)', 'Cristóbal Colón monument at the former Puerta de Santiago land approach', 'Fourth-centenary monument (1890s); city wall demolished 1897', 'Gate plazas urban gate to the walled city of Old San Juan; coastal Caribbean urban setting', 'Google Maps labels "Plaza Colón" San Juan · 18o26, San Juan, 00901 · 18.467, -66.116'],
    ['Plaza Colón, Mar del Plata, Argentina', 'Argentina · Buenos Aires Province, Mar del Plata (Atlantic coastal city)', 'Central urban plaza within the coastal visitor network of Mar del Plata', 'Twentieth-century consolidation of the coastal city, coastal civic circulation and events management', 'Coastal atmosphere and visitor seasonal circulation; dense coastal city centre use and events scale; Mar del Plata visitor; Buenos Aires Province context', 'Google Maps labels "Plaza Colón" Mar del Plata · Buenos Aires Province, Buenos Aires Province  Mar del Plata · -38.001, -57.545'],
  ],
  closingCoda: 'For archival clarity, plazacolonarg.com makes no claim to any of the three squares above beyond archival toponymic clarification in the Córdoba Alberdi square; always each space is materially distinct in character, municipal jurisdiction and current operating information. For hours, works and access for any of the three spaces listed, use the official municipal or tourism channel of that city, not this Córdoba guide.',
  note: 'This guide does not attribute Plaza Colón Córdoba to Carlos Thays. Archival and municipal descriptions consulted for this guide associate the 1955 planting redesign with architect Carlos David. All four entries above share a toponym but represent materially different public spaces; for current access, opening conditions and works, always consult the municipal or official channel listed for each place, not the present Córdoba guide.',
  references: [
    ['Ayuntamiento de Madrid · Jardines del Descubrimiento (Plaza de Colón)', 'https://www.madrid.es/portales/munimadrid/es/Inicio/El-Ayuntamiento/Parques-y-jardines/Patrimonio-Verde/Parques-en-Madrid/Jardines-del-Descubrimiento/?vgnextfmt=default&vgnextoid=185afce3b03ee210VgnVCM2000000c205a0aRCRD&vgnextchannel=38bb1914e7d4e210VgnVCM1000000b205a0aRCRD'],
    ['Puerto Rico Tourism Company · tourism.pr.gov (Official State Tourism)', 'https://tourism.pr.gov/'],
    ['Turismo Mar del Plata · Municipal Tourism Office', 'https://www.turismomardelplata.gob.ar/']
  ],
} : null;
---
<BaseLayout title={t.title} description={t.description} locale={locale} faqItems={faqItems}>
  <div id="top"></div><SiteHeader locale={locale} />
  <main id="content">
    <svg class="water-thread" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true"><path class="water-thread-shadow" d="M52 0 C92 58 10 105 54 166 S94 271 49 333 S5 442 52 500 S90 603 46 668 S13 772 53 834 S83 930 46 1000" /><path class="water-thread-line" d="M52 0 C92 58 10 105 54 166 S94 271 49 333 S5 442 52 500 S90 603 46 668 S13 772 53 834 S83 930 46 1000" /><g class="water-stations"><circle cx="53" cy="142" r="4" /><circle cx="50" cy="315" r="4" /><circle cx="51" cy="490" r="4" /><circle cx="48" cy="663" r="4" /><circle cx="52" cy="838" r="4" /></g></svg>
    <section class="hero" aria-labelledby="hero-title"><img class="hero-photo" src="/images/plaza-colon-fuente-atardecer.jpg" alt={en ? 'Cast-iron fountain at Plaza Colón in Córdoba' : 'Fuente de hierro fundido de Plaza Colón en Córdoba'} /><div class="hero-scrim"></div><div class="hero-copy"><p class="eyebrow light">{t.eyebrow}</p><h1 id="hero-title">{t.hero}<br /><em>{t.heroEm}</em></h1><p class="hero-intro">{t.intro}</p><div class="hero-actions"><a class="button button-bronze" href={`#${ids.visit}`}>{t.plan}</a><a class="button button-ghost" href="#map">{t.map}</a></div></div><div class="hero-plaque"><span>{t.founded}</span><strong>1888</strong><small>{t.plaque}</small></div><p class="photo-credit">{t.credit}</p></section>
    <section class="quick-facts" aria-label={en ? 'Visit facts' : 'Datos de visita'}>{t.facts.map(([label, value]) => <div><span>{label}</span><b>{value}</b></div>)}</section>
    <section id={ids.history} class="story-section section-wrap"><div class="section-marker"><span>01</span><i></i></div><div class="story-grid"><div class="story-intro"><p class="eyebrow">{t.historyLabel}</p><h2>{t.history}</h2><p class="lead">{t.historyLead}</p><a class="inline-link" href="https://turismo.cordoba.gob.ar/plaza-colon/" target="_blank" rel="noreferrer">{t.source} ↗</a></div><figure class="photo-frame photo-tall"><img src="/images/plaza-colon-fuente-y-parque.jpeg" alt={en ? 'Plaza Colón green layout seen from above' : 'Traza verde de Plaza Colón vista desde arriba'} loading="lazy" /><figcaption>{en ? 'A green urban trace within the city.' : 'Una traza verde dentro de la ciudad.'}</figcaption></figure><div class="story-notes">{t.timeline.map(([year, text]) => <article><b>{year}</b><p>{text}</p></article>)}</div></div><div class="ironwork" aria-hidden="true"></div></section>
    <section class="botanical-section"><div class="botanical-copy"><p class="eyebrow">{t.botLabel}</p><h2>{t.botTitle}<br /><em>{t.botEm}</em></h2><p>{t.botText}</p></div><div class="species-list" aria-label={en ? 'Species to notice' : 'Especies para observar'}>{['Fresno blanco / White ash', 'Tilo / Linden', 'Roble rojo americano / American red oak', 'Tipa / Tipu tree', 'Palmera pindó / Pindo palm'].map((item, i) => <span><i>0{i + 1}</i>{en ? item.split(' / ')[1] : item.split(' / ')[0]}</span>)}</div><div class="botanical-vignette" aria-hidden="true"></div></section>
    <section id={en ? 'disambiguation' : 'desambiguacion'} class="section-wrap disambig-screen" aria-labelledby="disambig-title"><div class="section-marker"><span>02</span><i></i></div><div class="disambig-intro"><p class="category-badge">{t.disambigCategory}</p><h2 id="disambig-title">{t.disambigTitle}<br /><em>{t.disambigEm}</em></h2><p class="disambig-lead">{t.disambigIntro}</p><ul class="disambig-bullets">{t.disambigBullets.map(([label, value]) => <li><span>{label}</span><b>{value}</b></li>)}</ul></div><div class="disambig-table-wrap" tabindex="0" role="region" aria-label={t.disambigTableTitle}><p class="section-label disambig-table-caption">{t.disambigTableTitle}</p><table><thead><tr>{t.disambigTableHead.flat().map((h) => <th scope="col">{h}</th>)}</tr></thead><tbody>{t.disambigTableRows.map((row, i) => <tr class={i === 0 ? 'row-hero' : undefined}>{row.map((cell, j) => j === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div><div class="disambig-faqs" aria-label={en ? 'Disambiguation FAQs' : 'FAQ de desambiguación'}>{t.disambigFaqs.map(([question, answer]) => <details class="faq-small"><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section id={en ? 'architecture-chronology' : 'arquitectura-cronologia'} class="section-wrap arch-screen" aria-labelledby="arch-title"><div class="section-marker"><span>03</span><i></i></div><div class="arch-grid"><div class="arch-reader"><p class="category-badge">{t.archCategory}</p><h2 id="arch-title">{t.archTitle}</h2><div class="arch-paragraphs">{t.archParagraphs.map((p) => <p>{p}</p>)}</div><figure class="photo-frame arch-frame"><img src="/images/plaza-colon-fuente-y-parque.jpeg" alt={en ? 'Cast-iron fountain and Alberdi planting' : 'Fuente de hierro fundido y plantación de Alberdi'} loading="lazy" /><figcaption>{t.archPhotoCaption}</figcaption></figure></div><aside class="chronology" aria-labelledby="chron-title"><h3 id="chron-title">{t.chronologyTitle}</h3><ol class="chrono-cards">{t.chronology.map(([year, text], idx) => <li class="chrono-card"><span class="chrono-index">0{idx + 1}</span><b class="chrono-year">{year}</b><p>{text}</p></li>)}</ol></aside></div></section>
    <section id={ids.visit} class="planner-section section-wrap"><div class="section-marker"><span>04</span><i></i></div><div class="planner-heading"><p class="eyebrow">{t.visitLabel}</p><h2>{t.visitTitle}<br /><em>{t.visitEm}</em></h2><p>{t.visitText}</p></div><div class="route-notes">{t.routes.map(([title, time, text, steps], i) => <article><span>0{i + 1}</span><p class="route-time">{time}</p><h3>{title}</h3><p>{text}</p><ul>{(steps as string[]).map((step) => <li>{step}</li>)}</ul></article>)}</div></section>
    <section class="practical-section"><div class="practical-photo"><img src="/images/plaza-colon-vista-aerea.jpeg" alt={en ? 'Plaza Colón within the urban fabric of Córdoba' : 'Plaza Colón dentro de la trama urbana de Córdoba'} loading="lazy" /></div><div class="practical-copy"><p class="eyebrow">{t.practicalLabel}</p><h2>{t.practicalTitle}<br /><em>{t.practicalEm}</em></h2><dl class="practical-list">{t.practical.map(([term, definition]) => <div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl></div></section>
    <section id={ids.transport} class="getting-there section-wrap"><div class="section-marker"><span>05</span><i></i></div><div class="arrival-intro"><p class="eyebrow">{t.transportLabel}</p><h2>{t.transportTitle}<br /><em>{t.transportEm}</em></h2><p>{t.transportText}</p></div><div class="mobility-grid mobility-grid-four">{t.transport.map(([title, text, action, href], i) => <article><span class="mobility-icon">0{i + 1}</span><h3>{title}</h3><p>{text}</p><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined}>{action}</a></article>)}</div></section>
    <section id={ids.services} class="services-section section-wrap"><div class="section-marker"><span>06</span><i></i></div><div class="services-heading"><p class="eyebrow">{t.servicesLabel}</p><h2>{t.servicesTitle}<br /><em>{t.servicesEm}</em></h2><p>{t.servicesText}</p></div><div class="service-notes">{t.services.map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section id="map" class="map-section"><div class="map-copy"><p class="eyebrow light">{en ? 'Meeting point' : 'Punto de encuentro'}</p><h2>{t.mapTitle}<br /><em>Córdoba</em></h2><p>Av. Colón · X5000EPZ<br />Córdoba, Argentina</p><a class="button button-bronze" href="https://maps.app.goo.gl/VFVHXX42gPEcgbg76" target="_blank" rel="noreferrer">{t.mapAction}</a></div><iframe title={en ? 'Map of Plaza Colón, Córdoba' : 'Mapa de Plaza Colón, Córdoba'} src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d24244.142221729235!2d-64.21480551284176!3d-31.409282399999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9432993038308dbd%3A0x6b19099e5c73a073!2sPlaza%20Col%C3%B3n!5e1!3m2!1ses-AR!2sar!4v1787715699114!5m2!1ses-AR!2sar" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></section>
    <section id={ids.nearby} class="nearby-section section-wrap"><div class="section-marker"><span>07</span><i></i></div><div class="nearby-heading"><p class="eyebrow">{t.nearbyLabel}</p><h2>{t.nearbyTitle}<br /><em>{t.nearbyEm}</em></h2></div><div class="nearby-columns"><div class="nearby-food"><p class="section-label">{en ? 'How to use this area' : 'Cómo usar este entorno'}</p><h3>{en ? 'A neutral neighbourhood guide.' : 'Una guía barrial neutral.'}</h3><p>{t.nearbyText}</p><p class="disclaimer">{en ? 'Schedules, access and programming change. Confirm directly with the place or public channel before making a special trip.' : 'Los horarios, accesos y programas cambian. Confirmá directamente con el lugar o canal público antes de hacer un viaje especial.'}</p></div><div class="nearby-sights"><p class="section-label">{en ? 'Places named by municipal tourism' : 'Lugares citados por Turismo Córdoba'}</p><ul>{t.sights.map(([title, text], i) => <li><span>0{i + 1}</span><div><b>{title}</b><p>{text}</p></div></li>)}</ul></div></div></section>
    <section class="method-section"><div><p class="eyebrow">{t.methodLabel}</p><h2>{t.methodTitle}</h2></div><p>{t.methodText}</p></section>
    {comparison && <section id="place-comparison" class="comparison-section section-wrap" aria-labelledby="comparison-title"><div class="section-marker"><span>08</span><i></i></div><div class="comparison-intro"><p class="eyebrow">{comparison.label}</p><h2 id="comparison-title">{comparison.title}<br /><em>{comparison.em}</em></h2><p>{comparison.subTitleIntro}</p><div class="comparison-focus-card" aria-label="Subject statement for this website"><p class="section-label">{en ? 'About this site · 100-word subject statement' : 'Sobre este sitio · Declaración de sujeto (100 palabras)'}</p><h3>{comparison.leadInFocus}</h3><p>{comparison.subjectStatement}</p></div></div><div class="comparison-distinctions" aria-label={en ? 'Three distinguishing highlights' : 'Tres puntos de distinción'}><h3 class="visually-hidden">{en ? 'Three distinguishing highlights' : 'Tres puntos de distinción'}</h3>{comparison.threeDistinctions.map(([num, title, body]) => <article class="distinction-card"><span class="distinction-num">{num}</span><h4>{title}</h4><p>{body}</p></article>)}</div><div class="comparison-table-wrap"><table><caption>Plaza Colón Córdoba vs. three homonymous squares — five-dimension comparison</caption><thead><tr><th scope="col">Place</th><th scope="col">Country / City</th><th scope="col">Core landmark</th><th scope="col">Founded / Named</th><th scope="col">Landscape character</th><th scope="col">Google Maps identification</th></tr></thead><tbody>{comparison.table.map(([place, countryCity, landmark, founded, landscape, mapsId]) => <tr class={place.includes('Córdoba') ? 'row-subject' : undefined}><th scope="row">{place}</th><td>{countryCity}</td><td>{landmark}</td><td>{founded}</td><td>{landscape}</td><td>{mapsId}</td></tr>)}</tbody></table></div><p class="comparison-coda">{comparison.closingCoda}</p><aside class="comparison-note"><span>Method note</span><p>{comparison.note}</p><div>{comparison.references.map(([name, href]) => <a href={href} target="_blank" rel="noreferrer">{name} ↗</a>)}</div></aside></section>}
    <section id="faq" class="faq-section"><div class="faq-heading"><p class="eyebrow">{t.faqLabel}</p><h2>{t.faqTitle}<br /><em>{t.faqEm}</em></h2></div><div class="faq-list">{t.faq.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="sources-section"><p class="eyebrow">{t.sourcesLabel}</p><div>{t.sources.map(([title, text, href]) => <a href={href} target="_blank" rel="noreferrer"><b>{title}</b><span>{text}</span><i>↗</i></a>)}</div></section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
