---
import '../styles/global.css';
import { SITE_NAME, SITE_NAME_EN } from '../data/site';
interface Props { title: string; description: string; locale?: 'es' | 'en'; faqItems?: Array<{question:string;answer:string}>; attraction?: boolean; noindex?: boolean; }
const { title, description, locale = 'es', faqItems = [], attraction = false, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://plazacolonarg.com');
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
const esPath = path.startsWith('/en/') ? path.slice(3) || '/' : path;
const enPath = '/en' + esPath;
const schema = {
 '@context':'https://schema.org', '@type':'TouristAttraction', '@id': new URL('/#attraction',site).href,
 name:'Plaza Colón, Córdoba, Argentina', alternateName:'Plaza Colón de Alberdi',
 description:locale === 'en' ? 'Public square on Av. Colón in Alberdi, Córdoba, Argentina, known for its cast-iron fountain and trees.' : 'Plaza pública sobre Av. Colón en Alberdi, Córdoba, Argentina, conocida por su fuente de hierro fundido y arbolado.',
 url: new URL(locale === 'en' ? '/en/' : '/', site).href,
 address:{'@type':'PostalAddress',streetAddress:'Av. Colón',postalCode:'X5000EPZ',addressLocality:'Córdoba',addressRegion:'Córdoba',addressCountry:'AR'},
 hasMap:'https://maps.app.goo.gl/VFVHXX42gPEcgbg76',
 image:new URL('/images/plaza-2022.jpg',site).href,
 sameAs:['https://maps.app.goo.gl/VFVHXX42gPEcgbg76','https://turismo.cordoba.gob.ar/cordoba-a-cielo-abierto-plaza-colon/']
};
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqItems.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))};
---
<!doctype html><html lang={locale === 'en' ? 'en' : 'es-AR'}><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#17382E" />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} /><link rel="canonical" href={canonical} />
{!noindex && <><link rel="alternate" hreflang="es" href={new URL(esPath,site).href} /><link rel="alternate" hreflang="en" href={new URL(enPath,site).href} /><link rel="alternate" hreflang="x-default" href={new URL(esPath,site).href} /></>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="apple-touch-icon" href="/apple-touch-icon.svg" /><link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<title>{title}</title><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:site_name" content={locale === 'en' ? SITE_NAME_EN : SITE_NAME} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/images/plaza-2022.jpg',site).href} /><meta property="og:image:alt" content={locale === 'en' ? 'Reference photograph of Plaza Colón in Córdoba, 2022' : 'Fotografía de referencia de Plaza Colón en Córdoba, 2022'} /><meta name="twitter:card" content="summary_large_image" />
<script is:inline src="/analytics-consent.js"></script>
{attraction && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
{faqItems.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
<script is:inline>if ('serviceWorker' in navigator) window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));</script>
</head><body><slot /></body></html>
