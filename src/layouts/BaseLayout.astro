---
/**
 * Design reminder — Herbario de hierro: airy botanical editorial layout, antique bronze details,
 * deep ink text, and real Plaza Colón photography as the dominant visual material.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: 'es' | 'en';
  faqItems?: Array<{ question: string; answer: string }>;
}

const { title, description, locale = 'es', faqItems = [] } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const isEnglish = locale === 'en';
const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings', 'Place'],
  name: 'Plaza Colón (Alberdi, Córdoba, Argentina)',
  alternateName: ['Plaza Colón Córdoba', 'Plaza Colón de Alberdi'],
  description: isEnglish
    ? 'Plaza Colón in the Alberdi neighbourhood of Córdoba, Argentina (Av. Colón, X5000EPZ, coordinates -31.4092824, -64.1957511). Public square opened 1888 as Plaza Juárez Celman, renamed 1892. Distinctive Parisian cast-iron two-tier fountain and 1955 Mini Botanical Garden design by architect Carlos David. Not to be confused with the homonymous Plaza de Colón in Madrid (Spain), Plaza Colón in San Juan, Puerto Rico or Plaza Colón in Mar del Plata, Buenos Aires, Argentina.'
    : 'Plaza Colón en el barrio Alberdi de Córdoba, Argentina (Av. Colón, X5000EPZ, coordenadas -31.4092824, -64.1957511). Plaza pública inaugurada en 1888 como Plaza Juárez Celman y renombrada en 1892. Distintiva fuente parisina de hierro fundido de dos bandejas y diseño de Mini Jardín Botánico de 1955 del arquitecto Carlos David. No confundir con las plazas homónimas de Madrid (España), San Juan (Puerto Rico) ni Mar del Plata (Buenos Aires, Argentina).',
  disambiguatingDescription: isEnglish
    ? 'Distinguished internationally by its inland Alberdi neighbourhood setting, Parisian cast-iron fountain and not being a Colón stone monument, giant national-flag plaza or walled-city gateway plaza.'
    : 'Se distingue internacionalmente por su emplazamiento en el barrio Alberdi del interior urbano, su fuente parisina de hierro fundido y por no ser un monumento pétreo a Colón, una plaza de bandera nacional gigante ni una plaza-puerta de ciudad amurallada.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Colón',
    postalCode: 'X5000EPZ',
    addressLocality: 'Córdoba',
    addressRegion: 'Córdoba',
    addressCountry: 'AR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: -31.4092824, longitude: -64.1957511, elevation: 430 },
  containedInPlace: [
    { '@type': 'Neighborhood', name: 'Alberdi, Córdoba' },
    { '@type': 'City', name: 'Córdoba, Argentina' },
  ],
  hasMap: 'https://maps.app.goo.gl/VFVHXX42gPEcgbg76',
  sameAs: ['https://turismo.cordoba.gob.ar/plaza-colon/'],
  openingHours: 'Mo-Su 00:00-23:59',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.1', reviewCount: '18791', bestRating: '5' },
  image: '/images/plaza-colon-fuente-atardecer.jpg',
  photo: {
    '@type': 'Photograph',
    image: '/images/plaza-colon-fuente-atardecer.jpg',
    caption: isEnglish ? 'Plaza Colón Córdoba cast-iron fountain at dusk.' : 'Fuente de hierro fundido de Plaza Colón Córdoba al atardecer.',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'distintivo_arquitectonico', value: 'Fuente parisina de dos bandejas en hierro fundido y cuatro farolas de París.' },
    { '@type': 'PropertyValue', name: 'nombre_anterior', value: 'Plaza Juárez Celman (1888–1892)' },
    { '@type': 'PropertyValue', name: 'no_es_homonima', value: isEnglish ? 'Not: Plaza de Colón Madrid, Plaza Colón San Juan PR, Plaza Colón Mar del Plata' : 'No es la Plaza de Colón de Madrid, ni Plaza Colón San Juan PR, ni Plaza Colón Mar del Plata.' },
  ],
  ...(canonical ? { url: canonical } : {}),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
};
---

<!doctype html>
<html lang={isEnglish ? 'en' : 'es-AR'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17382E" />
    <meta name="robots" content="index,follow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="16x16" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:image" content={new URL('/images/plaza-colon-fuente-atardecer.jpg', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      const loadAnalytics = () => {
        if (window.__plazaAnalyticsLoaded || localStorage.getItem('plaza-colon-analytics') !== 'granted') return;
        window.__plazaAnalyticsLoaded = true;
        const script = document.createElement('script'); script.async = true; script.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP'; document.head.appendChild(script);
        gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');
      };
      loadAnalytics(); window.addEventListener('plaza-consent-updated', loadAnalytics);
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </head>
  <body><slot /></body>
</html>
